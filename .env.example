# ─── Banco de Dados Principal ────────────────────────────────────────────────
# PostgreSQL para produção. Deixe vazio para usar SQLite (desenvolvimento).
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# ─── Senior ERP – SQL Server (MSSQL) ─────────────────────────────────────────
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=
MSSQL_USER=
MSSQL_PASS=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ─── Senior – API REST ────────────────────────────────────────────────────────
DOMAIN_API=
API_KEY=

# ─── TOTVS Protheus – WSGETDATA (REST → SQL) — feature 008 (EPI automático) ──
# Gateway de SQL do Protheus: a rotina diária consulta preços de EPI (SB1010).
# NÃO commitar credenciais — preencher só no .env local (gitignored). Ver
# specs/008-epi-auto-totvs/contracts/totvs-wsgetdata.md
TOTVS_WSGETDATA_URL=http://host:porta
TOTVS_WSGETDATA_USER=
TOTVS_WSGETDATA_PASSWORD=
# Horário do cron diário (HH:MM, 24h). Default 02:00.
TOTVS_SYNC_HORARIO=02:00

# ─── IA do faturamento – LLM local self-hosted (feature 010) ────────────────
# Endpoint compatível OpenAI (ex.: Ollama http://localhost:11434/v1). Vazio =
# IA desativada (router responde 503). Snapshot enviado é sem PII; nada sai da infra.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60

# ─── Senior – Serviços SOAP ──────────────────────────────────────────────────
SENIOR_SOAP_URL=https://webp33.seniorcloud.com.br:30721/g5-senior-services/rubi_Synccom_opus_fopag?wsdl
SENIOR_SOAP_NEXTI_URL=https://webp33.seniorcloud.com.br:30721/g5-senior-services/rubi_Synccom_opus_nexti
SENIOR_SOAP_USER=
SENIOR_SOAP_PASSWORD=
SENIOR_SOAP_TOKEN=
SENIOR_SOAP_ENCRYPTION=0

# Faturamento "só cálculo mensal": a integração devolve TODOS os cálculos da
# competência (mensal + rescisões/férias/13º) — sem filtro, infla o nº de pessoas.
# O codcal do mensal MUDA a cada mês, então o faturamento auto-detecta pelo EVENTO
# BASE do salário ("Dias Normais"). Ajuste só se a numeração do evento base mudar.
SENIOR_EVENTO_BASE_MENSAL=200
# Override manual (raro): força codcals específicos como "mensal" (separados por
# vírgula), ignorando a auto-detecção. Vazio = auto. Ex.: SENIOR_CODCAL_MENSAL=392
SENIOR_CODCAL_MENSAL=

# ─── SMTP (opcional, feature 002 — envio de solicitação de compra por email) ─
# Se SMTP_HOST estiver vazio, a UI esmaece o botão "Enviar por email" e mantém
# apenas o download do Excel. Preencher tudo para ativar o envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@grupoopus.com
SMTP_USE_TLS=1

# Destinatário padrão das solicitações de compra de EPI (editável no envio).
EPI_PURCHASE_EMAIL=compras@grupoopus.com

# ─── Cache e Throttle das Chamadas Senior (feature 003) ─────────────────────
# TTL em segundos. Lazy expiration: entrada expirada é descartada na próxima leitura.
# CCU (T018CCU) — quase estático; default 6h.
SENIOR_CACHE_CCU_TTL=21600
# Funcionários ativos por CCU+mês corrente; default 1h.
SENIOR_CACHE_EMPLOYEES_TTL=3600
# Máximo de chamadas SOAP simultâneas (semáforo bloqueante). Default 3.
SENIOR_SOAP_MAX_CONCURRENCY=3
